// Settings shared by all Snip Snap app builds.
// Public product names stay here so forks can replace them in Local.xcconfig.

SNIP_SNAP_PRODUCT_BUNDLE_IDENTIFIER = world.sree.snipsnap
SNIP_SNAP_APP_GROUP_IDENTIFIER = group.org.example.snipsnap
SNIP_SNAP_CLOUDKIT_CONTAINER_IDENTIFIER =
SNIP_SNAP_CLOUD_DEV_TRANSPORT_CONTRACT_ENABLED = NO

PRODUCT_BUNDLE_IDENTIFIER = $(SNIP_SNAP_PRODUCT_BUNDLE_IDENTIFIER)
PRODUCT_MODULE_NAME = SnipSnap
PRODUCT_NAME = Snip Snap

DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS =

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES
CLANG_ENABLE_MODULES = YES
COMBINE_HIDPI_IMAGES = YES
CURRENT_PROJECT_VERSION = 1
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES
ENABLE_PREVIEWS = YES
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = SnipSnap/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Snip Snap
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
MACOSX_DEPLOYMENT_TARGET = 26.0
MARKETING_VERSION = 0.5.0
REGISTER_APP_GROUPS = NO
STRING_CATALOG_GENERATE_SYMBOLS = YES
SWIFT_EMIT_LOC_STRINGS = YES
SWIFT_VERSION = 6.0
